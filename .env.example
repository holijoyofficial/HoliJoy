# Copy to .env.local and fill in. On Vercel, add these under
# Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> API
# Both are safe in the browser (data is protected by row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets: never prefix with NEXT_PUBLIC_, never commit.
# SUPABASE_SERVICE_ROLE_KEY=   (not needed yet)

# Demo accounts for the /demo page. Leave DEMO_MODE unset (off) in production after launch.
# DEMO_MODE=true
# DEMO_ANIMATOR_EMAIL=
# DEMO_ANIMATOR_PASSWORD=
# DEMO_HOTEL_EMAIL=
# DEMO_HOTEL_PASSWORD=
